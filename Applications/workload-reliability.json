{
  "id": null,
  "uid": "workload-reliability",
  "title": "Homelab / Workload Reliability",
  "description": "Workload failure symptoms and resource demand across configurable namespaces.",
  "tags": [
    "homelab",
    "operations"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "links": [
    {
      "title": "Homelab Overview",
      "url": "/d/homelab-overview",
      "type": "link",
      "targetBlank": false,
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Workload Reliability",
      "url": "/d/workload-reliability",
      "type": "link",
      "targetBlank": false,
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Prometheus Health",
      "url": "/d/prometheus-health",
      "type": "link",
      "targetBlank": false,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        },
        "refresh": 1
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(kube_pod_info, namespace)",
        "definition": "label_values(kube_pod_info, namespace)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 1,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "WORKLOADS · FIND THE FRICTION",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "### Find what is stuck, restarting or running out of room\nFilter by namespace, then use pod names to investigate. OOM panels show **the last recorded termination reason**, not the count of OOM events. Resource panels use raw metrics and require no custom recording rules."
      }
    },
    {
      "id": 2,
      "title": "Pending pods",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max by(namespace,pod) (kube_pod_status_phase{namespace=~\"$namespace\",phase=\"Pending\"}))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false,
            "axisBorderShow": false
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
