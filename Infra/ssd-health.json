{
  "id": null,
  "uid": "ssd-health",
  "title": "Homelab / SSD Health",
  "description": "Physical disk SMART health from smartctl_exporter. Virtual disks and Longhorn volumes are excluded.",
  "tags": [
    "homelab",
    "storage",
    "smart"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "links": [
    {
      "title": "Homelab Overview",
      "url": "/d/homelab-overview",
      "type": "link",
      "targetBlank": false,
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Workload Reliability",
      "url": "/d/workload-reliability",
      "type": "link",
      "targetBlank": false,
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Prometheus Health",
      "url": "/d/prometheus-health",
      "type": "link",
      "targetBlank": false,
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "SSD Health",
      "url": "/d/ssd-health",
      "type": "link",
      "targetBlank": false,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        },
        "refresh": 1
      },
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(up{namespace=\"monitoring\",job=~\".*smartctl.*\"}, node)",
        "definition": "label_values(up{namespace=\"monitoring\",job=~\".*smartctl.*\"}, node)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 1,
        "sort": 1
      },
      {
        "name": "device",
        "label": "Device",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(smartctl_device{namespace=\"monitoring\",node=~\"$node\"}, device)",
        "definition": "label_values(smartctl_device{namespace=\"monitoring\",node=~\"$node\"}, device)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 1,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Physical SSD monitoring coverage",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Node Feature Discovery automatically classifies hosts. SMART collection runs only on nodes with **hypervisor: none**, and automatically discovers physical **ATA/NVMe** disk identifiers every 5 minutes. VM hosts and Longhorn iSCSI volumes are excluded. Monitor VM backing SSDs on Proxmox. **No data means unavailable telemetry, not healthy.** NVMe panels are empty for SATA drives. SATA wear attributes vary by vendor and are not converted into a generic life percentage."
      }
    },
    {
      "id": 2,
      "title": "Exporter reachable",
      "description": "Exporter availability is separate from SMART availability.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{namespace=\"monitoring\",job=~\".*smartctl.*\",node=~\"$node\"}",
          "legendFormat": "{{node}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red"
                },
                "1": {
                  "text": "Up",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "SMART overall health",
      "description": "Passed does not guarantee the absence of defects.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "smartctl_device_smart_status{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\"}",
          "legendFormat": "{{node}} / {{device}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Failed",
                  "color": "red"
                },
                "1": {
                  "text": "Passed",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "SMART status available",
      "description": "Zero means no status was returned; a missing exporter remains No data.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count by(node) (smartctl_device_smart_status{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\"}) or on(node) (0 * up{namespace=\"monitoring\",job=~\".*smartctl.*\",node=~\"$node\"})",
          "legendFormat": "{{node}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "title": "SSD temperature",
      "description": "Alert starts at >60 C for 15 minutes; tune to vendor specification.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "smartctl_device_temperature{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\",temperature_type=\"current\"}",
          "legendFormat": "{{node}} / {{device}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
