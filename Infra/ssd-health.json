{
  "id": null,
  "uid": "ssd-health",
  "title": "Homelab / SSD Health",
  "description": "Automatically repeated node/disk health sections with essential SMART, wear, lifetime and error readings.",
  "tags": [
    "homelab",
    "storage",
    "smart"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "links": [
    {
      "title": "Homelab Overview",
      "url": "/d/homelab-overview",
      "type": "link",
      "targetBlank": false,
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Workload Reliability",
      "url": "/d/workload-reliability",
      "type": "link",
      "targetBlank": false,
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Prometheus Health",
      "url": "/d/prometheus-health",
      "type": "link",
      "targetBlank": false,
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "SSD Health",
      "url": "/d/ssd-health",
      "type": "link",
      "targetBlank": false,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        },
        "refresh": 1
      },
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(up{namespace=\"monitoring\",job=~\".*smartctl.*\"}, node)",
        "definition": "label_values(up{namespace=\"monitoring\",job=~\".*smartctl.*\"}, node)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 1,
        "sort": 1
      },
      {
        "name": "device",
        "label": "Device",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(smartctl_device{namespace=\"monitoring\",node=~\"$node\"}, device)",
        "definition": "label_values(smartctl_device{namespace=\"monitoring\",node=~\"$node\"}, device)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 1,
        "sort": 1
      },
      {
        "name": "disk_pair",
        "label": "Node / disk sections",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "query_result(label_join(smartctl_device{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\"}, \"disk_pair\", \" / \", \"node\", \"device\"))",
        "definition": "query_result(label_join(smartctl_device{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\"}, \"disk_pair\", \" / \", \"node\", \"device\"))",
        "regex": "/disk_pair=\"([^\"]+)\"/",
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 1,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Physical SSD monitoring coverage",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Each section repeats for one **node / physical disk** pair. This view focuses on health, temperature, wear, lifetime usage and errors. Only reported values are shown; **missing telemetry is not a healthy result**. Full read-only SMART reports remain available for troubleshooting. VM hosts and Longhorn iSCSI volumes are excluded."
      }
    },
    {
      "id": 19,
      "type": "row",
      "title": "$disk_pair",
      "repeat": "disk_pair",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 20,
      "title": "SMART overall health",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_join((smartctl_device_smart_status{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\"}), \"disk_pair\", \" / \", \"node\", \"device\") and on(disk_pair) label_replace(vector(1), \"disk_pair\", \"${disk_pair:raw}\", \"\", \"\")",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "{{device}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unavailable",
                  "color": "gray"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Failed",
                  "color": "red"
                },
                "1": {
                  "text": "Passed",
                  "color": "green"
                }
              }
            }
          ],
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 21,
      "title": "Temperature",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 6,
        "y": 4,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_join((smartctl_device_temperature{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\",temperature_type=\"current\"}), \"disk_pair\", \" / \", \"node\", \"device\") and on(disk_pair) label_replace(vector(1), \"disk_pair\", \"${disk_pair:raw}\", \"\", \"\")",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "{{device}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "noValue": "Unavailable",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 60
              },
              {
                "color": "red",
                "value": 70
              }
            ]
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unavailable",
                  "color": "gray"
                }
              }
            }
          ],
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "Initial display thresholds; tune to vendor ratings. Alert is above 60 C for 15 minutes."
    },
    {
      "id": 22,
      "title": "Power-on time",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_join((smartctl_device_power_on_seconds{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\"} / 3600), \"disk_pair\", \" / \", \"node\", \"device\") and on(disk_pair) label_replace(vector(1), \"disk_pair\", \"${disk_pair:raw}\", \"\", \"\")",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "{{device}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: hours",
          "noValue": "Unavailable",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unavailable",
                  "color": "gray"
                }
              }
            }
          ],
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 23,
      "title": "Report freshness",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 18,
        "y": 4,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_join((time() - smartctl_extended_collection_timestamp_seconds{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\"}), \"disk_pair\", \" / \", \"node\", \"device\") and on(disk_pair) label_replace(vector(1), \"disk_pair\", \"${disk_pair:raw}\", \"\", \"\")",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "{{device}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Unavailable",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 600
              },
              {
                "color": "red",
                "value": 900
              }
            ]
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unavailable",
                  "color": "gray"
                }
              }
            }
          ],
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "Age of the last successful full SMART report. Stale and failed collection have dedicated alerts."
    },
    {
      "id": 24,
      "title": "Disk identity",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_join((smartctl_device{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\"}), \"disk_pair\", \" / \", \"node\", \"device\") and on(disk_pair) label_replace(vector(1), \"disk_pair\", \"${disk_pair:raw}\", \"\", \"\")",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": "{{device}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unavailable",
                  "color": "gray"
                }
              }
            }
          ],
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "model_name",
                "serial_number",
                "firmware_version",
                "protocol",
                "form_factor"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "model_name": "Model",
              "serial_number": "Serial",
              "firmware_version": "Firmware",
              "protocol": "Protocol",
              "form_factor": "Form factor"
            }
          }
        }
      ]
    },
    {
      "id": 25,
      "title": "Health and lifetime readings",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_join((label_replace(max by(node,device) (smartctl_device_capacity_bytes{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\"} / 1e9), \"reading\", \"Capacity (GB)\", \"device\", \".*\") or label_replace(max by(node,device) (smartctl_device_power_cycle_count{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\"}), \"reading\", \"Power cycles\", \"device\", \".*\") or label_replace(max by(node,device) ((smartctl_device_attribute{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\",attribute_value_type=\"raw\",attribute_name=~\"Unsafe_Shutdown_Count|Unexpect_Power_Loss_Ct\"} or smartctl_extended_value{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\",section=\"nvme_smart_health_information_log\",field=\"unsafe_shutdowns\"})), \"reading\", \"Unexpected power losses / unsafe shutdowns\", \"device\", \".*\") or label_replace(max by(node,device) (smartctl_device_attribute{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\",attribute_value_type=\"raw\",attribute_name=\"SSD_Life_Left\"}), \"reading\", \"SATA reported life left (vendor raw value)\", \"device\", \".*\") or label_replace(max by(node,device) (smartctl_device_attribute{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\",attribute_value_type=\"raw\",attribute_name=~\"Wear_Leveling_Count|Average_Erase_Count\"}), \"reading\", \"SATA wear / erase count (vendor raw value)\", \"device\", \".*\") or label_replace(max by(node,device) ((smartctl_device_bytes_read{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\"} / 1099511627776 or smartctl_device_attribute{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\",attribute_value_type=\"raw\",attribute_name=\"Lifetime_Reads_GiB\"} / 1024)), \"reading\", \"Lifetime read (TiB)\", \"device\", \".*\") or label_replace(max by(node,device) ((smartctl_device_bytes_written{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\"} / 1099511627776 or smartctl_device_attribute{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\",attribute_value_type=\"raw\",attribute_name=\"Lifetime_Writes_GiB\"} / 1024)), \"reading\", \"Lifetime written (TiB)\", \"device\", \".*\") or label_replace(max by(node,device) (smartctl_device_percentage_used{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\"}), \"reading\", \"NVMe rated endurance consumed (%)\", \"device\", \".*\") or label_replace(max by(node,device) (smartctl_device_available_spare{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\"}), \"reading\", \"NVMe available spare (%)\", \"device\", \".*\") or label_replace(max by(node,device) (smartctl_device_available_spare_threshold{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\"}), \"reading\", \"NVMe spare threshold (%)\", \"device\", \".*\") or label_replace(max by(node,device) (smartctl_device_critical_warning{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\"}), \"reading\", \"NVMe critical warning (bitmask)\", \"device\", \".*\") or label_replace(max by(node,device) (smartctl_device_media_errors{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\"}), \"reading\", \"NVMe media / integrity errors\", \"device\", \".*\") or label_replace(max by(node,device) (smartctl_device_num_err_log_entries{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\"}), \"reading\", \"NVMe error log entries\", \"device\", \".*\") or label_replace(max by(node,device) (smartctl_device_error_log_count{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\"}), \"reading\", \"SMART error log entries\", \"device\", \".*\") or label_replace(max by(node,device) (smartctl_device_self_test_log_error_count{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\"}), \"reading\", \"Reported self-test failures\", \"device\", \".*\")), \"disk_pair\", \" / \", \"node\", \"device\") and on(disk_pair) label_replace(vector(1), \"disk_pair\", \"${disk_pair:raw}\", \"\", \"\")",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unavailable",
                  "color": "gray"
                }
              }
            }
          ],
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "Only supported readings relevant to disk health. Lifetime transfer conversion uses known byte/GiB counters; unknown vendor units are not guessed. SATA wear/life values keep their vendor meaning. Missing readings are omitted, never filled with zero.",
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "reading",
                "Value"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "reading": "Reading (unit)",
              "Value": "Value"
            }
          }
        }
      ]
    },
    {
      "id": 26,
      "title": "Temperature history",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_join((smartctl_device_temperature{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\"}), \"disk_pair\", \" / \", \"node\", \"device\") and on(disk_pair) label_replace(vector(1), \"disk_pair\", \"${disk_pair:raw}\", \"\", \"\")",
          "instant": false,
          "range": true,
          "format": "time_series",
          "legendFormat": "{{temperature_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unavailable",
                  "color": "gray"
                }
              }
            }
          ],
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 27,
      "title": "Reported defect/error counters",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_join((smartctl_device_attribute{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\",attribute_value_type=\"raw\",attribute_id=~\"5|171|172|181|182|183|184|187|188|196|197|198|199|218\"}), \"disk_pair\", \" / \", \"node\", \"device\") and on(disk_pair) label_replace(vector(1), \"disk_pair\", \"${disk_pair:raw}\", \"\", \"\")",
          "instant": false,
          "range": true,
          "format": "time_series",
          "legendFormat": "{{attribute_id}} / {{attribute_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unavailable",
                  "color": "gray"
                }
              }
            }
          ],
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Raw SATA diagnostic attributes as reported, including communication errors. Values are vendor-specific and may be packed; inspect full attributes before interpreting them as counts."
    },
    {
      "id": 28,
      "title": "SATA health attributes",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
