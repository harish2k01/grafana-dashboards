{
  "id": null,
  "uid": "ssd-health",
  "title": "Homelab / SSD Health",
  "description": "Physical disk SMART health from smartctl_exporter. Virtual disks and Longhorn volumes are excluded.",
  "tags": [
    "homelab",
    "storage",
    "smart"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "links": [
    {
      "title": "Homelab Overview",
      "url": "/d/homelab-overview",
      "type": "link",
      "targetBlank": false,
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Workload Reliability",
      "url": "/d/workload-reliability",
      "type": "link",
      "targetBlank": false,
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Prometheus Health",
      "url": "/d/prometheus-health",
      "type": "link",
      "targetBlank": false,
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "SSD Health",
      "url": "/d/ssd-health",
      "type": "link",
      "targetBlank": false,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        },
        "refresh": 1
      },
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(up{namespace=\"monitoring\",job=~\".*smartctl.*\"}, node)",
        "definition": "label_values(up{namespace=\"monitoring\",job=~\".*smartctl.*\"}, node)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 1,
        "sort": 1
      },
      {
        "name": "device",
        "label": "Device",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(smartctl_device{namespace=\"monitoring\",node=~\"$node\"}, device)",
        "definition": "label_values(smartctl_device{namespace=\"monitoring\",node=~\"$node\"}, device)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 1,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Physical SSD monitoring coverage",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Node Feature Discovery automatically classifies hosts. SMART collection runs only on nodes with **hypervisor: none**, and automatically discovers physical **ATA/NVMe** disk identifiers every 5 minutes. VM hosts and Longhorn iSCSI volumes are excluded. Monitor VM backing SSDs on Proxmox. **No data means unavailable telemetry, not healthy.** NVMe panels are empty for SATA drives. SATA wear attributes vary by vendor and are not converted into a generic life percentage."
      }
    },
    {
      "id": 15,
      "title": "SMART / Health information",
      "description": "Latest SMART values by disk, similar to smartctl output. Decimal TB = bytes / 10^12. NVMe data units = bytes / 512000. Unavailable means not applicable, not reported, or not exposed by exporter v0.14.0; it never means zero. Host command counts, controller busy time, composite temperature durations and individual NVMe sensors are not exposed by this exporter. SATA life-left is a vendor raw attribute, not a universal percentage.",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_join((label_replace((max by(node,device) (smartctl_device_smart_status{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\"}) or on(node,device) (max by(node,device) (smartctl_device{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\"}) * (0/0))), \"health_field\", \"SMART passed (1=yes, 0=no)\", \"device\", \".*\") or label_replace((max by(node,device) (smartctl_device_critical_warning{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\"}) or on(node,device) (max by(node,device) (smartctl_device{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\"}) * (0/0))), \"health_field\", \"Critical warning (numeric bitmask)\", \"device\", \".*\") or label_replace((max by(node,device) (smartctl_device_temperature{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\",temperature_type=\"current\"}) or on(node,device) (max by(node,device) (smartctl_device{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\"}) * (0/0))), \"health_field\", \"Temperature (C)\", \"device\", \".*\") or label_replace((max by(node,device) (smartctl_device_available_spare{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\"}) or on(node,device) (max by(node,device) (smartctl_device{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\"}) * (0/0))), \"health_field\", \"Available spare (%)\", \"device\", \".*\") or label_replace((max by(node,device) (smartctl_device_available_spare_threshold{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\"}) or on(node,device) (max by(node,device) (smartctl_device{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\"}) * (0/0))), \"health_field\", \"Available spare threshold (%)\", \"device\", \".*\") or label_replace((max by(node,device) (smartctl_device_percentage_used{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\"}) or on(node,device) (max by(node,device) (smartctl_device{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\"}) * (0/0))), \"health_field\", \"NVMe percentage used (%)\", \"device\", \".*\") or label_replace((max by(node,device) (smartctl_device_bytes_read{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\"} / 512000) or on(node,device) (max by(node,device) (smartctl_device{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\"}) * (0/0))), \"health_field\", \"Data units read (NVMe)\", \"device\", \".*\") or label_replace((max by(node,device) (smartctl_device_bytes_written{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\"} / 512000) or on(node,device) (max by(node,device) (smartctl_device{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\"}) * (0/0))), \"health_field\", \"Data units written (NVMe)\", \"device\", \".*\") or label_replace((max by(node,device) (smartctl_device_bytes_read{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\"} / 1e12) or on(node,device) (max by(node,device) (smartctl_device{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\"}) * (0/0))), \"health_field\", \"Data read (TB, NVMe)\", \"device\", \".*\") or label_replace((max by(node,device) (smartctl_device_bytes_written{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\"} / 1e12) or on(node,device) (max by(node,device) (smartctl_device{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\"}) * (0/0))), \"health_field\", \"Data written (TB, NVMe)\", \"device\", \".*\") or label_replace((max by(node,device) (smartctl_device{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\"}) * (0/0)), \"health_field\", \"Host read commands\", \"device\", \".*\") or label_replace((max by(node,device) (smartctl_device{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\"}) * (0/0)), \"health_field\", \"Host write commands\", \"device\", \".*\") or label_replace((max by(node,device) (smartctl_device{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\"}) * (0/0)), \"health_field\", \"Controller busy time (minutes)\", \"device\", \".*\") or label_replace((max by(node,device) (smartctl_device_power_cycle_count{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\"}) or on(node,device) (max by(node,device) (smartctl_device{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\"}) * (0/0))), \"health_field\", \"Power cycles\", \"device\", \".*\") or label_replace((max by(node,device) (smartctl_device_power_on_seconds{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\"} / 3600) or on(node,device) (max by(node,device) (smartctl_device{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\"}) * (0/0))), \"health_field\", \"Power-on hours\", \"device\", \".*\") or label_replace((max by(node,device) (smartctl_device_attribute{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\",attribute_value_type=\"raw\",attribute_name=~\"Unsafe_Shutdown_Count|Unexpect_Power_Loss_Ct\"}) or on(node,device) (max by(node,device) (smartctl_device{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\"}) * (0/0))), \"health_field\", \"Unsafe shutdowns / unexpected power losses (SATA)\", \"device\", \".*\") or label_replace((max by(node,device) (smartctl_device_media_errors{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\"}) or on(node,device) (max by(node,device) (smartctl_device{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\"}) * (0/0))), \"health_field\", \"Media and data integrity errors (NVMe)\", \"device\", \".*\") or label_replace((max by(node,device) (smartctl_device_num_err_log_entries{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\"}) or on(node,device) (max by(node,device) (smartctl_device{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\"}) * (0/0))), \"health_field\", \"Error information log entries (NVMe)\", \"device\", \".*\") or label_replace((max by(node,device) (smartctl_device{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\"}) * (0/0)), \"health_field\", \"Warning composite temperature time (minutes)\", \"device\", \".*\") or label_replace((max by(node,device) (smartctl_device{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\"}) * (0/0)), \"health_field\", \"Critical composite temperature time (minutes)\", \"device\", \".*\") or label_replace((max by(node,device) (smartctl_device{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\"}) * (0/0)), \"health_field\", \"Temperature sensor 1 (C)\", \"device\", \".*\") or label_replace((max by(node,device) (smartctl_device_attribute{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\",attribute_value_type=\"raw\",attribute_name=\"SSD_Life_Left\"}) or on(node,device) (max by(node,device) (smartctl_device{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\"}) * (0/0))), \"health_field\", \"SATA SSD_Life_Left (vendor raw value)\", \"device\", \".*\")), \"disk\", \" / \", \"node\", \"device\")",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "health_field",
                "disk",
                "Value"
              ]
            }
          }
        },
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "disk",
            "rowField": "health_field",
            "valueField": "Value",
            "emptyValue": "null"
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "health_field\\disk": "SMART / Health field",
              "health_field": "SMART / Health field"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "decimals": 2,
          "noValue": "Unavailable",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "Unavailable",
                  "color": "gray"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unavailable",
                  "color": "gray"
                }
              }
            }
          ],
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 2,
      "title": "Exporter reachable",
      "description": "Exporter availability is separate from SMART availability.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{namespace=\"monitoring\",job=~\".*smartctl.*\",node=~\"$node\"}",
          "legendFormat": "{{node}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red"
                },
                "1": {
                  "text": "Up",
                  "color": "green"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "No data",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "SMART overall health",
      "description": "Passed does not guarantee the absence of defects.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 20,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "smartctl_device_smart_status{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\"}",
          "legendFormat": "{{node}} / {{device}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Failed",
                  "color": "red"
                },
                "1": {
                  "text": "Passed",
                  "color": "green"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "No data",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "SMART status available",
      "description": "Number of disks reporting SMART status on each node. At least one is available; zero means telemetry is missing.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 20,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count by(node) (smartctl_device_smart_status{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\"}) or on(node) (0 * up{namespace=\"monitoring\",job=~\".*smartctl.*\",node=~\"$node\"})",
          "legendFormat": "{{node}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "No data",
                  "color": "gray"
                }
              }
            }
          ],
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "title": "SSD temperature",
      "description": "Alert starts at >60 C for 15 minutes; tune to vendor specification.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "smartctl_device_temperature{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\",temperature_type=\"current\"}",
          "legendFormat": "{{node}} / {{device}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "title": "Power-on time (days)",
      "description": "Lifetime powered-on time in days. Age is informational; colour does not indicate health.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(smartctl_device_power_on_seconds{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\"}) / 86400",
          "legendFormat": "{{node}} / {{device}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: days",
          "noValue": "No data",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 7,
      "title": "SATA reallocated sectors",
      "description": "Raw SMART attribute 5. Confirm vendor interpretation.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "smartctl_device_attribute{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\",attribute_value_type=\"raw\",attribute_id=\"5\"}",
          "legendFormat": "{{node}} / {{device}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "title": "SATA pending / uncorrectable sectors",
      "description": "Raw attributes 197 and 198.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "smartctl_device_attribute{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\",attribute_value_type=\"raw\",attribute_id=~\"197|198\"}",
          "legendFormat": "{{node}} / {{device}} / {{attribute_name}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "title": "NVMe endurance consumed",
      "description": "NVMe only. 100% is the estimated rated endurance consumed; may exceed 100%.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 12,
        "h": 8
      },
      "targets": [
