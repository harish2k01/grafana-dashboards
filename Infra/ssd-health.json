      "targets": [
        {
          "refId": "A",
          "expr": "smartctl_device_attribute{namespace=\"monitoring\",node=~\"$node\",device=~\"$device\",attribute_value_type=\"raw\",attribute_id=~\"197|198\"}",
          "legendFormat": "{{node}} / {{device}} / {{attribute_name}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
